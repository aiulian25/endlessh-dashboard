# endlessh-dashboard configuration.
#
#   cp .env.example .env   then edit .env
#
# The app reads process environment variables only. Compose env_file: .env or
# docker --env-file .env injects this file; the binary and make run do not load it.
# Mounted secret files and *_FILE variables are not supported. Configure a
# launcher/secret manager to inject values as environment variables instead.
#
# WARNING: never commit a filled-in copy of this file. A real .env holds the
# admin password. Only this example belongs in version control; .env is
# excluded from git by .gitignore and from the Docker build context by
# .dockerignore.

# ---- Server -----------------------------------------------------------------

# Address the HTTP server listens on. Leave the host part empty: :18222 listens on every
# interface inside the container, which is what lets a published port reach it at all.
# Narrowing this to 127.0.0.1:18222 makes the container unreachable from your LAN even
# though it looks healthy — control exposure with the compose ports: line instead.
LISTEN_ADDR=:18222

# How much reaches the container log: debug | info | warn | error.
#
# debug adds one line per HTTP request — method, path, status and how long it
# took — which is what to reach for when a reverse proxy or a CSRF header is
# misbehaving and the interface is not saying enough. Only the path is logged,
# never the query string, and never a password or a session token. It is
# noticeable on a busy dashboard, so it is a setting to turn on while looking at
# something and off again afterwards.
LOG_LEVEL=info

# Directory for the SQLite database and backups. The only path the container writes to.
DATA_DIR=/data

# ---- Scraping ---------------------------------------------------------------

# Nominal interval per enabled target. A busy worker pool can delay starts.
SCRAPE_INTERVAL=15s

# Per-scrape HTTP timeout; a slow or dead target is given up on after this.
SCRAPE_TIMEOUT=5s

# Maximum concurrent scrape/parse/database jobs, including Test connection.
# Valid range: 1..32. Four is a conservative default, not a fleet-size guarantee.
# No response bodies are queued; check last-success age if starts fall behind.
SCRAPE_CONCURRENCY=4

# ---- Retention --------------------------------------------------------------

# Days of history to keep. Rollups and attackers unseen for longer are pruned nightly.
RETENTION_DAYS=90

# ---- Authentication ---------------------------------------------------------

# Username of the single admin account, created on first start. Changing it
# later does nothing: it is read only while the account is being created, so an
# install that already has a user ignores it. At most 64 bytes — note bytes, not
# characters, so accented or non-Latin names reach the limit sooner. Left empty
# or blank it falls back to admin.
ADMIN_USERNAME=admin

# REQUIRED on first start: seeds the admin account. You are forced to change it
# at first login, after which this value is ignored and can be removed.
ADMIN_PASSWORD=

# Secure flag on session cookies: auto | on | off. auto sets it whenever the
# request arrived over TLS directly, or a peer in TRUSTED_PROXY_CIDRS supplies
# exactly one X-Forwarded-Proto: https value. Untrusted headers are ignored.
# Sessions themselves are stored in the database and looked up by the hash of a random token, so there is no
# signing key to configure or keep in step across restarts.
SECURE_COOKIES=auto

# How long a sign-in stays valid before the dashboard logs you out and asks for
# the password again. The clock starts at sign-in and does not slide with
# activity: the session ends when it ends, whatever you are doing.
#
# Go duration string: 30m, 8h, 168h. There is no day unit — "7d" is a syntax
# error, not a week; write 168h. Minimum 1m, maximum 720h (30 days), and
# anything outside that is refused at startup rather than quietly accepted.
SESSION_LIFETIME=12h

# Comma-separated CIDRs of reverse proxies trusted for client IP and HTTPS scheme.
# Empty — the default — means the address a request arrives from is the client,
# which is the truth when the dashboard is reached directly.
#
# Set it when a reverse proxy sits in front, and list only the proxy's own
# address: 127.0.0.1/32 for a proxy on this host, or the Docker network the
# proxy container sits on. Every request then arrives from that one address, and
# without this the login throttle counts them all as a single client — five
# wrong passwords from anybody locks the account for everybody for fifteen
# minutes, over and over. With it, the address the proxy reports in
# X-Forwarded-For is throttled instead, so one bad client locks out only itself.
#
# List the proxy and nothing else. Whatever is named here is trusted to name the
# client, so a range wide enough to include clients lets them claim any address
# they like, and a client that picks its own address is one the throttle cannot
# hold. In auto cookie mode, these peers are also trusted for X-Forwarded-Proto.
# The proxy must overwrite that header with one http or https value, never append
# a chain or preserve the caller's value; duplicate/comma-list values are ignored.
# This does not delegate authentication; passwords are still checked in full.
TRUSTED_PROXY_CIDRS=

# ---- Optional local GeoIP ---------------------------------------------------

# Path to a MaxMind GeoLite2 .mmdb mounted read-only into the container. Empty
# disables enrichment. Lookups are strictly local; no GeoIP service is contacted.
GEOIP_MMDB_PATH=

# ---- Optional online GeoIP --------------------------------------------------

# Look attackers up with an online provider when neither the tarpit's own labels
# nor the local database could place them. This is the only thing this app ever
# sends anywhere, and the consequence is worth stating plainly: true means
# attacker IP addresses are sent to the configured provider, one per request.
# The default is ip-api.com over unencrypted HTTP; custom HTTPS encrypts transport. It
# is off by default and stays off unless you set it to true here; when it is on,
# the container logs a startup warning naming only the provider host and scheme.
GEOIP_ONLINE=false

# Requests per minute the backfill worker is allowed to make. ip-api.com's free
# tier allows 45 a minute per source address; 40 leaves headroom. Maximum 45.
GEOIP_ONLINE_RATE_PER_MINUTE=40

# The lookup URL. {ip} is replaced with the address being resolved, and must be
# present; http:// or https:// only. Empty uses ip-api.com's free endpoint,
# asking only for the fields the dashboard stores. Private and LAN addresses are
# never sent to it at all.
GEOIP_ONLINE_ENDPOINT=

# ---- Scrape target policy ---------------------------------------------------

# Comma-separated CIDRs allowed as scrape targets even though they are normally
# refused (loopback, link-local, cloud metadata). Empty means no exceptions.
SCRAPE_ALLOWLIST_CIDRS=

# Refuse RFC1918 private addresses as scrape targets. Off by default because
# home-lab tarpits usually sit on a private LAN. Set true if every target is public.
SCRAPE_BLOCK_PRIVATE=false

# ---- Backups ----------------------------------------------------------------

# Take an automatic consistent snapshot once a day into DATA_DIR/backups.
BACKUP_DAILY=false

# How many backups to keep; older ones are deleted after each new backup.
BACKUP_KEEP_LAST=7

# ---- Reverse-proxy delegated auth -------------------------------------------

# Reverse-proxy-delegated authentication (trusting a Remote-User header from
# Authelia, authentik and friends) is NOT implemented; the built-in login is the
# only authentication path today. It is listed as a possible future addition in
# the README rather than offered here as a setting that does nothing.
