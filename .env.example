# endlessh-dashboard configuration.
#
#   cp .env.example .env   then edit .env
#
# WARNING: never commit a filled-in copy of this file. A real .env holds the
# admin password. Only this example belongs in version control; .env is
# excluded from git by .gitignore and from the Docker build context by
# .dockerignore.

# ---- Server -----------------------------------------------------------------

# Address the HTTP server listens on. Leave the host part empty: :18222 listens on every
# interface inside the container, which is what lets a published port reach it at all.
# Narrowing this to 127.0.0.1:18222 makes the container unreachable from your LAN even
# though it looks healthy — control exposure with the compose ports: line instead.
LISTEN_ADDR=:18222

# Directory for the SQLite database and backups. The only path the container writes to.
DATA_DIR=/data

# ---- Scraping ---------------------------------------------------------------

# How often every registered machine's Prometheus /metrics endpoint is polled.
SCRAPE_INTERVAL=15s

# Per-scrape HTTP timeout; a slow or dead target is given up on after this.
SCRAPE_TIMEOUT=5s

# ---- Retention --------------------------------------------------------------

# Days of history to keep. Rollups and attackers unseen for longer are pruned nightly.
RETENTION_DAYS=90

# ---- Authentication ---------------------------------------------------------

# Username of the single admin account, created on first start.
ADMIN_USERNAME=admin

# REQUIRED on first start: seeds the admin account. You are forced to change it
# at first login, after which this value is ignored and can be removed.
ADMIN_PASSWORD=

# Secure flag on session cookies: auto | on | off. auto sets it whenever the
# request arrived over HTTPS, directly or via X-Forwarded-Proto, which is the
# right behaviour behind a TLS-terminating proxy. Sessions themselves are stored
# in the database and looked up by the hash of a random token, so there is no
# signing key to configure or keep in step across restarts.
SECURE_COOKIES=auto

# ---- Optional local GeoIP ---------------------------------------------------

# Path to a MaxMind GeoLite2 .mmdb mounted read-only into the container. Empty
# disables enrichment. Lookups are strictly local; no GeoIP service is contacted.
GEOIP_MMDB_PATH=

# ---- Optional online GeoIP --------------------------------------------------

# Look attackers up with an online provider when neither the tarpit's own labels
# nor the local database could place them. This is the only thing this app ever
# sends anywhere, and the consequence is worth stating plainly: true means
# attacker IP addresses leave this container, one per request, in clear
# unencrypted HTTP, to ip-api.com (or whatever GEOIP_ONLINE_ENDPOINT names). It
# is off by default and stays off unless you set it to true here; when it is on,
# the container logs a startup warning naming the endpoint.
GEOIP_ONLINE=false

# Requests per minute the backfill worker is allowed to make. ip-api.com's free
# tier allows 45 a minute per source address; 40 leaves headroom. Maximum 45.
GEOIP_ONLINE_RATE_PER_MINUTE=40

# The lookup URL. {ip} is replaced with the address being resolved, and must be
# present; http:// or https:// only. Empty uses ip-api.com's free endpoint,
# asking only for the fields the dashboard stores. Private and LAN addresses are
# never sent to it at all.
GEOIP_ONLINE_ENDPOINT=

# ---- Scrape target policy ---------------------------------------------------

# Comma-separated CIDRs allowed as scrape targets even though they are normally
# refused (loopback, link-local, cloud metadata). Empty means no exceptions.
SCRAPE_ALLOWLIST_CIDRS=

# Refuse RFC1918 private addresses as scrape targets. Off by default because
# home-lab tarpits usually sit on a private LAN. Set true if every target is public.
SCRAPE_BLOCK_PRIVATE=false

# ---- Backups ----------------------------------------------------------------

# Take an automatic consistent snapshot once a day into DATA_DIR/backups.
BACKUP_DAILY=false

# How many backups to keep; older ones are deleted after each new backup.
BACKUP_KEEP_LAST=7

# ---- Reverse-proxy delegated auth -------------------------------------------

# Reverse-proxy-delegated authentication (trusting a Remote-User header from
# Authelia, authentik and friends) is NOT implemented; the built-in login is the
# only authentication path today. It is listed as a possible future addition in
# the README rather than offered here as a setting that does nothing.
